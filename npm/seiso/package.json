{
  "name": "@scarletkc/seiso",
  "version": "0.2.0",
  "description": "A Markdown convention and linter for project docs written by AI and read by humans and agents",
  "license": "MIT",
  "author": "scarletkc",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/scarletkc/seiso.git",
    "directory": "npm/seiso"
  },
  "homepage": "https://github.com/scarletkc/seiso#readme",
  "bugs": "https://github.com/scarletkc/seiso/issues",
  "bin": {
    "seiso": "bin/seiso.cjs"
  },
  "files": ["bin/", "LICENSE", "README.md"],
  "os": ["darwin", "linux", "win32"],
  "cpu": ["arm64", "x64"],
  "engines": {
    "node": ">=18"
  },
  "scripts": {
    "prepack": "node scripts/verify.cjs"
  },
  "optionalDependencies": {
    "@scarletkc/seiso-darwin-arm64": "0.2.0",
    "@scarletkc/seiso-darwin-x64": "0.2.0",
    "@scarletkc/seiso-linux-arm64": "0.2.0",
    "@scarletkc/seiso-linux-arm64-musl": "0.2.0",
    "@scarletkc/seiso-linux-x64": "0.2.0",
    "@scarletkc/seiso-linux-x64-musl": "0.2.0",
    "@scarletkc/seiso-win32-arm64": "0.2.0",
    "@scarletkc/seiso-win32-x64": "0.2.0"
  },
  "keywords": ["markdown", "documentation", "linter", "markdown-linter", "docs-as-code", "ai-agents", "cli"]
}
